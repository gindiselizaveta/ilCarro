<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="suite1" verbose="1">
    <test name="negative_tests">
        <groups>
            <run>
                <include name="negative"/>
                <exclude name="signup"/>
            </run>
        </groups>
        <classes>
            <class name="ui_tests.LoginTests"/>
            <class name="ui_tests.AddCarTests"/>
            <class name="ui_tests.SearchCarTests"/>
            <class name="ui_tests.SignUpTests"/>
        </classes>
    </test>
</suite>